# Required: Telegram bot token from @BotFather
BOT_TOKEN=

# Required: one or more admin Telegram IDs (comma-separated)
# Example: 123456789 or 123456789,987654321
ADMIN_TELEGRAM_IDS=

# Backward compatible single-admin variable (optional if ADMIN_TELEGRAM_IDS is set)
ADMIN_TELEGRAM_ID=

# Required: PostgreSQL connection string
# Railway Postgres reference example:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=

# Recommended for Railway webhook mode
# Example: https://<your-service>.up.railway.app
WEBHOOK_URL=

# Optional runtime settings
PORT=8080
TIMEZONE=Europe/Moscow
NAME=Найра
MODE=production
SCHEDULE_VISUALIZATION=1
HIDDEN_SERVICE_CATEGORIES=
PRODUCT_SETTINGS_PATH=content_settings.json

# Booking defaults
SLOT_STEP_MIN=30
BUFFER_MIN=10
MIN_LEAD_TIME_MIN=0
BOOKING_HORIZON_DAYS=30
HOLD_TTL_MIN=720
CANCEL_LIMIT_HOURS=2
WORK_START=10:00
WORK_END=19:00
WORK_DAYS=0,1,2,3,4,5,6
